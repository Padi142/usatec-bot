# Phone number of the Signal account the bot runs as (international format).
SIGNAL_NUMBER=+420123456789

# e-INFRA CZ / CERIT-SC AI-as-a-Service (OpenAI-compatible API).
# Get a key at https://chat.ai.e-infra.cz -> Settings -> Account -> API keys.
LLM_BASE_URL=https://llm.ai.e-infra.cz/v1
LLM_API_KEY=your-e-infra-api-key
# Prefer a maintained alias (deepseek, kimi, glm, mini, ...): the models behind
# them get swapped over time, but the alias names keep working.
# Current list: https://docs.cerit-sc.cz/en/docs/ai-as-a-service/chat-ai
LLM_MODEL=deepseek
# The service has a shared queue, so allow for slow responses at peak times.
# LLM_TIMEOUT=300
# Transcript size limit in characters; oldest messages are dropped beyond it.
# LLM_MAX_INPUT_CHARS=60000

# /tldr with no number summarizes this many messages.
# TLDR_DEFAULT_COUNT=50
# Upper limit for /tldr N.
# TLDR_MAX_COUNT=500
# Messages kept per group in the database; older ones are deleted.
# HISTORY_LIMIT=5000

# API key for /mackagen (research.kocicividea.cz). Without it, /mackagen is disabled.
# CAT_GEN_API_KEY=

# Discord cat bot (included alongside Signal in docker-compose.yml).
# Both DISCORD_TOKEN and CAT_GEN_API_KEY are required for the Compose stack.
# DISCORD_TOKEN=
# Optional: register slash commands in just this server instead of globally.
# DISCORD_GUILD_ID=

# Comma-separated group ids (either "group.xxx" or internal ids). Empty = all groups.
# ALLOWED_GROUPS=

# Only used when running outside docker:
# SIGNAL_API_URL=http://localhost:8080
# DB_PATH=messages.db
# LOG_LEVEL=INFO

# Timezone for message timestamps in the transcript.
TZ=Europe/Prague
